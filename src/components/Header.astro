---
const { base } = Astro.props;
---

<header id="main-header">
	<a href={base}>
		<div class="logo">
			<img
				src={`${base}images/logo/logo.svg`}
				alt="Logo"
				width="40"
				height="40"
			/>
			<span>Andy D.</span>
		</div>
	</a>

	<nav>
		<ul>
			<li>
				<a href={base}><span>Accueil</span></a>
			</li>

			<li>
				<a href={`${base}contact`}><span>Contact</span></a>
			</li>

			<li>
				<a href={`${base}cv`}><span class="cv-circle">CV</span></a>
			</li>
		</ul>
	</nav>
</header>
